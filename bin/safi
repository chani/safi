#!/usr/bin/env php
<?php

declare(strict_types=1);

use Safi\Core\Assembler;
use Safi\Core\Cli\CommandInterface;
use Safi\Core\Cli\CommandKernel;
use Safi\Core\Cli\Commands\DiDumpCommand;

$boot = require __DIR__ . '/../init.inc.php';

$container = $boot['assembler'];
$cliKernel = new CommandKernel($container);

$cliKernel->registerCommandClass(DiDumpCommand::class);

if ($container instanceof Assembler) {
    foreach ($container->getServiceIds() as $serviceId) {
        if (class_exists($serviceId) && is_subclass_of($serviceId, CommandInterface::class)) {
            $cliKernel->registerCommandClass($serviceId);
        }
    }
}

$cliArgs = $argv ?? $GLOBALS['argv'] ?? [];
exit($cliKernel->run(is_array($cliArgs) ? $cliArgs : []));

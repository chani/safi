{% extends "_page.twig" %} {% block title %}{{ title }}{% endblock %} {% block
content %}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<div
  style="
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  "
>
  <div>
    <h3 style="margin: 0">
      <i class="fa-solid fa-book"></i> Framework Documentation
    </h3>
    <small style="color: var(--safi-text-muted)"
      >Interactive Diátaxis documentation reader for Safi Microframework</small
    >
  </div>
  <a
    href="/hello"
    class="copper-btn"
    style="text-decoration: none; padding: 0.4rem 0.8rem"
  >
    <i class="fa-solid fa-arrow-left"></i> Back to Cockpit
  </a>
</div>

<!-- Main Split Layout: Left Content, Right Tree Sidebar -->
<div style="display: flex; gap: 1.5rem; align-items: flex-start">
  <!-- Left / Middle: Markdown Render Container -->
  <article style="flex: 1; min-width: 0; padding: 1.5rem">
    <header
      style="
        margin-bottom: 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      "
    >
      <span
        style="color: var(--safi-cyan); font-size: 0.88rem; font-weight: 600"
      >
        <i class="fa-solid fa-file-code"></i> docs/{{ active_file }}
      </span>
      <small style="color: var(--safi-text-muted)"
        >Diátaxis Documentation Standard</small
      >
    </header>

    <!-- Rendered Markdown Output -->
    <div
      id="markdown-viewer"
      class="markdown-body"
      style="font-size: 0.92rem; line-height: 1.65; color: var(--safi-text)"
    ></div>

    <!-- Hidden Raw Markdown Data Source -->
    <script id="raw-markdown" type="text/template">
      {{ markdown_content|raw }}
    </script>
  </article>

  <!-- Right: Navigation Tree Sidebar -->
  <aside style="width: 290px; flex-shrink: 0">
    <article style="padding: 1.25rem">
      <header
        style="
          margin-bottom: 0.85rem;
          border-bottom: 1px solid rgba(255, 255, 255, 0.08);
          padding-bottom: 0.5rem;
        "
      >
        <h4 style="margin: 0; font-size: 1rem; color: var(--safi-copper)">
          <i class="fa-solid fa-folder-tree"></i> Document Index
        </h4>
      </header>

      <div style="font-size: 0.85rem">
        {% for folder, files in docs_tree %}
        <div style="margin-bottom: 0.85rem">
          <strong
            style="
              color: var(--safi-text);
              font-size: 0.82rem;
              text-transform: uppercase;
              letter-spacing: 0.5px;
              display: block;
              margin-bottom: 0.35rem;
            "
          >
            <i
              class="fa-solid fa-folder-open"
              style="color: var(--safi-copper); margin-right: 0.3rem"
            ></i>
            {{ folder }}
          </strong>

          <ul style="list-style: none; padding-left: 0.75rem; margin: 0">
            {% for file in files %} {% set relPath = folder ~ '/' ~ file %}
            <li style="margin-bottom: 0.25rem">
              <a
                href="/admin/docs?file={{ relPath }}"
                style="text-decoration: none; display: flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0.5rem; border-radius: 4px; transition: all 0.2s ease;
                            {% if active_file == relPath %} background: rgba(102, 252, 241, 0.15); color: var(--safi-cyan); font-weight: 600; {% else %} color: var(--safi-text-muted); {% endif %}"
              >
                <i
                  class="fa-solid {% if active_file == relPath %}fa-file-code{% else %}fa-file-lines{% endif %}"
                  style="font-size: 0.8em"
                ></i>
                <span
                  style="
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                  "
                  >{{ file }}</span
                >
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% else %}
        <p style="color: var(--safi-text-muted)">
          No documentation files found.
        </p>
        {% endfor %}
      </div>
    </article>
  </aside>
</div>

<!-- Markdown Client-Side Renderer & Styling -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const rawMarkdown = document.getElementById("raw-markdown").innerHTML;
    const viewer = document.getElementById("markdown-viewer");

    if (typeof marked !== "undefined") {
      viewer.innerHTML = marked.parse(rawMarkdown);
    } else {
      viewer.innerHTML = "<pre>" + rawMarkdown + "</pre>";
    }
  });
</script>

<style>
  /* Dark Markdown Custom Styling */
  .markdown-body h1,
  .markdown-body h2,
  .markdown-body h3,
  .markdown-body h4 {
    color: var(--safi-cyan);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.4rem;
  }
  .markdown-body p {
    margin-bottom: 1rem;
  }
  .markdown-body code {
    background: rgba(0, 0, 0, 0.4) !important;
    color: var(--safi-cyan) !important;
    padding: 0.2rem 0.4rem !important;
    border-radius: 4px;
    font-size: 0.88em;
  }
  .markdown-body pre {
    background: rgba(10, 12, 15, 0.8) !important;
    border: 1px solid rgba(102, 252, 241, 0.15);
    padding: 1rem !important;
    border-radius: 6px;
    overflow-x: auto;
  }
  .markdown-body pre code {
    background: transparent !important;
    padding: 0 !important;
    color: #c5c9d0 !important;
  }
  .markdown-body blockquote {
    border-left: 3px solid var(--safi-copper);
    background: rgba(200, 125, 83, 0.08);
    margin: 1rem 0;
    padding: 0.6rem 1rem;
    color: #e28743;
  }
  .markdown-body ul,
  .markdown-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .markdown-body table {
    width: 100%;
    margin-bottom: 1rem;
    border-collapse: collapse;
  }
  .markdown-body th {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--safi-copper);
    text-align: left;
    padding: 0.5rem;
  }
  .markdown-body td {
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding: 0.5rem;
  }
</style>
{% endblock %}

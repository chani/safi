{% extends "_page.twig" %} {% block title %}{{ title }}{% endblock %} {% block
content %}
<div
  style="
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  "
>
  <div>
    <h3 style="margin: 0">
      <i class="fa-solid fa-microchip"></i> DI Container &amp; Engine Registry
    </h3>
    <small style="color: var(--safi-text-muted)"
      >Real-time dynamic introspection of active DI instances, package versions,
      and domain components</small
    >
  </div>
  <a
    href="/hello"
    class="copper-btn"
    style="text-decoration: none; padding: 0.4rem 0.8rem"
  >
    <i class="fa-solid fa-arrow-left"></i> Back to Cockpit
  </a>
</div>

<!-- SECTION 1: ACTIVE DI BINDINGS -->
<article style="margin-bottom: 1.5rem">
  <header style="margin-bottom: 1rem">
    <h4 style="margin: 0; font-size: 1.1rem; color: var(--safi-cyan)">
      <i class="fa-solid fa-plug"></i> 1. Active DI Service Bindings &amp;
      Concrete Classes
    </h4>
    <small style="color: var(--safi-text-muted)"
      >Real-time class instances resolved by Safi Assembler</small
    >
  </header>

  <table style="width: 100%; font-size: 0.88rem; border-collapse: collapse">
    <thead>
      <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
        <th style="padding: 0.6rem; text-align: left">Interface / Contract</th>
        <th style="padding: 0.6rem; text-align: left">
          Active Implementation Class
        </th>
        <th style="padding: 0.6rem; text-align: left">Role / Driver</th>
        <th style="padding: 0.6rem; text-align: left">Category</th>
      </tr>
    </thead>
    <tbody>
      {% for binding in di_bindings %}
      <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04)">
        <td style="padding: 0.6rem">
          <code>{{ binding.contract }}</code>
        </td>
        <td style="padding: 0.6rem">
          <strong style="color: var(--safi-cyan)"
            >{{ binding.implementation }}</strong
          >
        </td>
        <td style="padding: 0.6rem">
          <span style="color: #45d8a0; font-weight: 600"
            >{{ binding.driver }}</span
          >
        </td>
        <td style="padding: 0.6rem">
          <small style="color: var(--safi-text-muted)"
            >{{ binding.type }}</small
          >
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</article>

<!-- SECTION 2: LOADED COMPOSER PACKAGES -->
<article style="margin-bottom: 1.5rem">
  <header style="margin-bottom: 1rem">
    <h4 style="margin: 0; font-size: 1.1rem; color: var(--safi-copper)">
      <i class="fa-solid fa-puzzle-piece"></i> 2. Installed Safi Packages
      (Composer API)
    </h4>
    <small style="color: var(--safi-text-muted)"
      >Installed framework extensions detected dynamically via Composer
      InstalledVersions</small
    >
  </header>

  <table style="width: 100%; font-size: 0.88rem; border-collapse: collapse">
    <thead>
      <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
        <th style="padding: 0.6rem; text-align: left">Package Name</th>
        <th style="padding: 0.6rem; text-align: left">Installed Version</th>
        <th style="padding: 0.6rem; text-align: left">Runtime Status</th>
      </tr>
    </thead>
    <tbody>
      {% for ext in loaded_extensions %}
      <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04)">
        <td style="padding: 0.6rem">
          <strong style="color: var(--safi-copper)">{{ ext.name }}</strong>
        </td>
        <td style="padding: 0.6rem">
          <code>{{ ext.version }}</code>
        </td>
        <td style="padding: 0.6rem">
          <span style="color: var(--safi-cyan); font-weight: 600"
            >{{ ext.status }}</span
          >
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</article>

<!-- SECTION 3: APPLICATION DOMAIN COMPONENTS -->
<article>
  <header style="margin-bottom: 1rem">
    <h4 style="margin: 0; font-size: 1.1rem; color: var(--safi-text)">
      <i class="fa-solid fa-cubes"></i> 3. Application Components (Business
      Logic)
    </h4>
    <small style="color: var(--safi-text-muted)"
      >Isolated domain components under <code>components/*</code></small
    >
  </header>

  <table style="width: 100%; font-size: 0.88rem; border-collapse: collapse">
    <thead>
      <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
        <th style="padding: 0.6rem; text-align: left">Component Name</th>
        <th style="padding: 0.6rem; text-align: left">Namespace</th>
        <th style="padding: 0.6rem; text-align: left">Path</th>
        <th style="padding: 0.6rem; text-align: left">Architecture</th>
        <th style="padding: 0.6rem; text-align: left">Status</th>
      </tr>
    </thead>
    <tbody>
      {% for comp in installed_components %}
      <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04)">
        <td style="padding: 0.6rem">
          <strong style="color: #ffffff">{{ comp.name }}</strong>
        </td>
        <td style="padding: 0.6rem">
          <code>{{ comp.namespace }}</code>
        </td>
        <td style="padding: 0.6rem">
          <small style="color: var(--safi-text-muted)">{{ comp.path }}</small>
        </td>
        <td style="padding: 0.6rem">
          {% if comp.has_controllers %}
          <span
            style="
              background: rgba(102, 252, 241, 0.1);
              color: var(--safi-cyan);
              padding: 0.15rem 0.4rem;
              border-radius: 3px;
              font-size: 0.75rem;
            "
            >Controllers</span
          >
          {% endif %} {% if comp.has_views %}
          <span
            style="
              background: rgba(255, 255, 255, 0.08);
              color: var(--safi-text);
              padding: 0.15rem 0.4rem;
              border-radius: 3px;
              font-size: 0.75rem;
            "
            >Views</span
          >
          {% endif %} {% if comp.has_models %}
          <span
            style="
              background: rgba(200, 125, 83, 0.15);
              color: var(--safi-copper);
              padding: 0.15rem 0.4rem;
              border-radius: 3px;
              font-size: 0.75rem;
            "
            >Models</span
          >
          {% endif %}
        </td>
        <td style="padding: 0.6rem">
          <span style="color: #45d8a0; font-weight: 600"
            ><i class="fa-solid fa-circle-check"></i> {{ comp.status }}</span
          >
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</article>
{% endblock %}

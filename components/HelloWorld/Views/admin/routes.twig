{% extends "_page.twig" %} {% block title %}{{ title }}{% endblock %} {% block
content %}
<div
  style="
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  "
>
  <div>
    <h3 style="margin: 0">
      <i class="fa-solid fa-route"></i> Route Topology Explorer
    </h3>
    <small style="color: var(--safi-text-muted)"
      >Complete overview of all endpoints registered in the system ({{
      total_routes }} routes)</small
    >
  </div>
  <a
    href="/hello"
    class="copper-btn"
    style="text-decoration: none; padding: 0.4rem 0.8rem"
  >
    <i class="fa-solid fa-arrow-left"></i> Back to Cockpit
  </a>
</div>

<article>
  <!-- Live Filter Bar -->
  <div style="margin-bottom: 1.25rem">
    <input
      type="text"
      id="route-search"
      placeholder="Filter by path, name, controller, or HTTP verb..."
      onkeyup="filterRoutes()"
      style="width: 100%; font-size: 0.9rem"
    />
  </div>

  <table
    id="routes-table"
    style="width: 100%; font-size: 0.88rem; border-collapse: collapse"
  >
    <thead>
      <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1)">
        <th style="padding: 0.6rem; text-align: left">Verb</th>
        <th style="padding: 0.6rem; text-align: left">URI Path</th>
        <th style="padding: 0.6rem; text-align: left">Route Name</th>
        <th style="padding: 0.6rem; text-align: left">
          Target Controller Action
        </th>
        <th style="padding: 0.6rem; text-align: left">Active Middlewares</th>
        <th style="padding: 0.6rem; text-align: left">Access</th>
      </tr>
    </thead>
    <tbody>
      {% for r in routes %}
      <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04)">
        <td style="padding: 0.61rem">
          {% if r.method == 'GET' %}
          <span
            style="
              background: rgba(102, 252, 241, 0.15);
              color: var(--safi-cyan);
              padding: 0.2rem 0.5rem;
              border-radius: 4px;
              font-weight: bold;
              font-size: 0.78rem;
            "
            >GET</span
          >
          {% elseif r.method == 'POST' %}
          <span
            style="
              background: rgba(200, 125, 83, 0.2);
              color: var(--safi-copper);
              padding: 0.2rem 0.5rem;
              border-radius: 4px;
              font-weight: bold;
              font-size: 0.78rem;
            "
            >POST</span
          >
          {% else %}
          <span
            style="
              background: rgba(255, 255, 255, 0.1);
              color: var(--safi-text);
              padding: 0.2rem 0.5rem;
              border-radius: 4px;
              font-weight: bold;
              font-size: 0.78rem;
            "
            >{{ r.method }}</span
          >
          {% endif %}
        </td>
        <td style="padding: 0.61rem"><code>{{ r.path }}</code></td>
        <td style="padding: 0.61rem">
          <small style="color: var(--safi-text-muted)">{{ r.name }}</small>
        </td>
        <td style="padding: 0.61rem">
          <code style="color: var(--safi-cyan)">{{ r.target }}</code>
        </td>
        <td style="padding: 0.61rem">
          {% for mw in r.middlewares %}
          <span
            style="
              background: rgba(255, 255, 255, 0.05);
              padding: 0.15rem 0.4rem;
              border-radius: 3px;
              font-size: 0.75rem;
              margin-right: 0.2rem;
              display: inline-block;
              margin-bottom: 0.2rem;
            "
          >
            {{ mw }}
          </span>
          {% endfor %}
        </td>
        <td style="padding: 0.61rem">
          {% if r.public %}
          <span style="color: var(--safi-text-muted); font-size: 0.8rem"
            >Public</span
          >
          {% else %}
          <span style="color: #45d8a0; font-weight: 600; font-size: 0.8rem"
            ><i class="fa-solid fa-lock"></i> Protected</span
          >
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</article>

<script>
  function filterRoutes() {
    const input = document.getElementById("route-search");
    const filter = input.value.toLowerCase();
    const table = document.getElementById("routes-table");
    const trs = table.getElementsByTagName("tr");

    for (let i = 1; i < trs.length; i++) {
      const text = trs[i].textContent || trs[i].innerText;
      if (text.toLowerCase().indexOf(filter) > -1) {
        trs[i].style.display = "";
      } else {
        trs[i].style.display = "none";
      }
    }
  }
</script>
{% endblock %}

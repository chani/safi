{% extends "_page.twig" %} {% block title %}{{ title }}{% endblock %} {% block
content %}
<!-- Row 1: Real-time Runtime KPIs -->
<div class="safi-grid-3">
  <article>
    <small
      style="
        color: var(--safi-text-muted);
        font-weight: 600;
        font-size: 0.85rem;
      "
      >EXECUTION LATENCY</small
    >
    <h2
      style="margin: 0.25rem 0 0 0; color: var(--safi-cyan); font-weight: 700"
    >
      {{ telemetry.execution_time_ms }} ms
    </h2>
    <small style="color: var(--safi-text-muted); font-size: 0.8rem"
      >PHP {{ telemetry.php_version }} ({{ telemetry.sapi }})</small
    >
  </article>

  <article>
    <small
      style="
        color: var(--safi-text-muted);
        font-weight: 600;
        font-size: 0.85rem;
      "
      >RAM &amp; PEAK FOOTPRINT</small
    >
    <h2 style="margin: 0.25rem 0 0 0; color: #ffffff; font-weight: 700">
      {{ telemetry.memory_current_mb }} MB
      <small style="font-size: 0.55em; color: var(--safi-text-muted)"
        >(Peak {{ telemetry.memory_peak_mb }} MB)</small
      >
    </h2>
    <small style="color: var(--safi-text-muted); font-size: 0.8rem"
      >Database Storage: {{ telemetry.db_size_kb }} KB</small
    >
  </article>

  <article>
    <small
      style="
        color: var(--safi-text-muted);
        font-weight: 600;
        font-size: 0.85rem;
      "
      >ACCELERATOR ENGINE</small
    >
    <div style="margin-top: 0.25rem; font-size: 0.88rem">
      {% if telemetry.opcache.active %}
      <span style="color: #45d8a0; font-weight: 600">OPcache Active</span> ({{
      telemetry.opcache.hit_rate }}% Hits) {% else %}
      <span style="color: #ff6b7b; font-weight: 600">OPcache Inactive</span>
      {% endif %}
      <br />
      {% if telemetry.apcu_active %}
      <span style="color: #45d8a0; font-weight: 600">APCu Shared RAM:</span> {{
      telemetry.apcu_memory_mb }} MB {% else %}
      <span style="color: var(--safi-text-muted)"
        >APCu: Inactive (JSON Fallback)</span
      >
      {% endif %}
    </div>
  </article>
</div>

<!-- Row 2: Live Exceptions Stream & System Config Checklist -->
<div class="safi-grid-2">
  <article>
    <header
      style="
        margin-bottom: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      "
    >
      <h4 style="margin: 0; font-size: 1.05rem">
        <i class="fa-solid fa-bug"></i> Live Exception &amp; Error Stream
      </h4>
      <small style="color: var(--safi-text-muted)"
        ><code>data/logs/app.log</code></small
      >
    </header>
    <div style="font-size: 0.88rem; max-height: 180px; overflow-y: auto">
      {% if telemetry.recent_logs is empty %}
      <p style="color: #45d8a0; margin: 0; padding-left: 10px">
        <i class="fa-solid fa-check-circle"></i> Clean log state. No system
        exceptions recorded.
      </p>
      {% else %} {% for log in telemetry.recent_logs %}
      <div
        style="
          margin-bottom: 0.35rem;
          border-bottom: 1px solid rgba(255, 255, 255, 0.05);
          padding-bottom: 0.25rem;
          padding-left: 10px;
          color: #ff6b7b;
        "
      >
        <code>{{ log }}</code>
      </div>
      {% endfor %} {% endif %}
    </div>
  </article>

  <article>
    <header style="margin-bottom: 0.75rem">
      <h4 style="margin: 0; font-size: 1.05rem">
        <i class="fa-solid fa-file-code"></i> Active Configuration Files
      </h4>
    </header>
    <ul style="list-style: none; padding-left: 10px; margin: 0">
      {% for file, exists in telemetry.config_files %}
      <li
        style="
          margin-bottom: 0.55rem;
          font-size: 0.9rem;
          display: flex;
          justify-content: space-between;
        "
      >
        <code>{{ file }}</code>
        {% if exists %}
        <span style="color: #45d8a0; font-weight: 600"
          ><i class="fa-solid fa-check"></i> Loaded</span
        >
        {% else %}
        <span style="color: var(--safi-text-muted)"
          ><i class="fa-solid fa-xmark"></i> Not Present</span
        >
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </article>
</div>

<!-- Row 3: Security, Database & Queue Status -->
<div class="safi-grid-3">
  <article>
    <header style="margin-bottom: 0.75rem">
      <h4 style="margin: 0; font-size: 1.05rem">
        <i class="fa-solid fa-shield-halved"></i> Brute Force Shield
      </h4>
    </header>
    <ul
      style="list-style: none; padding-left: 10px; margin: 0; font-size: 0.9rem"
    >
      <li style="margin-bottom: 0.4rem">
        <strong>Active IP Bans:</strong>
        <span
          style="color: {% if telemetry.banned_ips > 0 %}#ff6b7b{% else %}#45d8a0{% endif %}; font-weight: bold;"
          >{{ telemetry.banned_ips }}</span
        >
      </li>
      <li>
        <strong>Failed Auth Attempts:</strong> {{ telemetry.failed_attempts }}
      </li>
    </ul>
  </article>

  <article>
    <header style="margin-bottom: 0.75rem">
      <h4 style="margin: 0; font-size: 1.05rem">
        <i class="fa-solid fa-gauge-high"></i> Slow Query Audit
      </h4>
    </header>
    {% if telemetry.slow_queries is empty %}
    <p
      style="color: #45d8a0; font-size: 0.88rem; margin: 0; padding-left: 10px"
    >
      <i class="fa-solid fa-check"></i> Zero queries >100ms.
    </p>
    {% else %} {% for sq in telemetry.slow_queries %}
    <div style="font-size: 0.82rem; margin-bottom: 0.35rem; padding-left: 10px">
      <code>{{ sq.sql_query }}</code> ({{ sq.duration_ms }}ms)
    </div>
    {% endfor %} {% endif %}
  </article>

  <article>
    <header style="margin-bottom: 0.75rem">
      <h4 style="margin: 0; font-size: 1.05rem">
        <i class="fa-solid fa-list-check"></i> Job Queue Worker
      </h4>
    </header>
    <ul
      style="list-style: none; padding-left: 10px; margin: 0; font-size: 0.9rem"
    >
      <li style="margin-bottom: 0.4rem">
        <strong>Pending Jobs:</strong>
        <span style="color: var(--safi-cyan); font-weight: bold"
          >{{ telemetry.pending_jobs }}</span
        >
      </li>
      <li>
        <strong>Failed Jobs:</strong>
        <span
          style="color: {% if telemetry.failed_jobs > 0 %}#ff6b7b{% else %}var(--safi-text-muted){% endif %}; font-weight: bold;"
          >{{ telemetry.failed_jobs }}</span
        >
      </li>
    </ul>
  </article>
</div>

<!-- Row 4: Dedicated System Inspectors Navigation Hub -->
<article>
  <header style="margin-bottom: 0.75rem">
    <h4 style="margin: 0; font-size: 1.05rem">
      <i class="fa-solid fa-compass"></i> System Inspectors &amp; Inventories
    </h4>
  </header>
  <p
    style="
      font-size: 0.88rem;
      color: var(--safi-text-muted);
      margin-bottom: 1rem;
      padding-left: 10px;
    "
  >
    Complete, non-truncated system catalogs and architectural maps:
  </p>

  <div class="safi-grid-3">
    <a
      href="/admin/routes"
      class="copper-btn"
      style="text-decoration: none; text-align: center; padding: 0.8rem"
    >
      <i class="fa-solid fa-route"></i> Route Topology Explorer
    </a>
    <a
      href="/admin/packages"
      class="copper-btn"
      style="text-decoration: none; text-align: center; padding: 0.8rem"
    >
      <i class="fa-solid fa-puzzle-piece"></i> Packages &amp; Components
    </a>
    <a
      href="/admin/docs"
      class="copper-btn"
      style="text-decoration: none; text-align: center; padding: 0.8rem"
    >
      <i class="fa-solid fa-book"></i> Framework Documentation
    </a>
  </div>
</article>
{% endblock %}

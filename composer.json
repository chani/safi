{
    "name": "chani/safi",
    "description": "Application skeleton for the Safi Microframework.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jean Bruenn",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "chani/safi-core": "^0.1.4",
        "chani/safi-router-wajha": "^0.1.3",
        "chani/safi-view-twig": "^0.1.1",
        "chani/safi-db-redbean": "^0.1.2",
        "chani/safi-auth": "^0.1.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Components\\": "components/"
        }
    },
    "archive": {
        "exclude": [
            "/docs",
            "/tests",
            ".php-cs-fixer.dist.php",
            "phpunit.xml",
            "psalm.xml",
            "phpstan.neon",
            "rector.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}

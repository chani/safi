{
  "name": "chani/safi",
  "description": "Application skeleton for the Safi Microframework.",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Jean Bruenn",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5",
    "chani/safi-core": "^0.1.18",
    "chani/safi-router-wajha": "^0.1.12",
    "chani/safi-view-twig": "^0.1.6",
    "chani/safi-db-redbean": "^0.1.11",
    "chani/safi-auth": "^0.1.15",
    "chani/safi-session": "^0.1.5",
    "chani/safi-admin-panel": "^0.1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Components\\": "components/"
    }
  },
  "archive": {
    "exclude": [
      "/docs",
      "/tests",
      ".php-cs-fixer.dist.php",
      "phpunit.xml",
      "psalm.xml",
      "phpstan.neon",
      "rector.php"
    ]
  },
  "config": {
    "optimize-autoloader": true
  },
  "repositories": [
    {
      "type": "path",
      "url": "../safi-*"
    },
    {
      "type": "path",
      "url": "../wajha-router"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev",
      "dev-master": "0.1.x-dev"
    }
  }
}

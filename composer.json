{
    "name": "chani/safi",
    "description": "Application skeleton for the Safi Microframework.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jean Bruenn",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "chani/safi-core": "*",
        "chani/safi-router-wajha": "*",
        "chani/safi-view-twig": "*",
        "chani/safi-db-redbean": "*",
        "chani/safi-auth": "*",
        "chani/safi-queue": "*",
        "chani/safi-search": "*",
        "chani/safi-session": "*",
        "chani/safi-cache": "*",
	"chani/safi-i18n": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Components\\": "components/"
        }
    },
    "archive": {
        "exclude": [
            "/docs",
            "/tests",
            ".php-cs-fixer.dist.php",
            "phpunit.xml",
            "psalm.xml",
            "phpstan.neon",
            "rector.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    },
    "autoload-dev": {
        "psr-4": {
            "Safi\\Core\\": "../safi-core/src/",
            "Safi\\Extensions\\Auth\\": "../safi-auth/src/",
            "Safi\\Extensions\\DbRedBean\\": "../safi-db-redbean/src/",
            "Safi\\Extensions\\RouterWajha\\": "../safi-router-wajha/src/",
            "Safi\\Extensions\\ViewTwig\\": "../safi-view-twig/src/",
            "Safi\\Extensions\\I18n\\": "../safi-i18n/src/",
            "Safi\\Extensions\\Queue\\": "../safi-queue/src/",
            "Safi\\Extensions\\Search\\": "../safi-search/src/",
            "Safi\\Extensions\\Session\\": "../safi-session/src/",
            "Safi\\Extensions\\Cache\\": "../safi-cache/src/",
            "Safi\\Wajha\\": "../wajha-router/src/"
        }
    },
    "version": "0.1.12",
    "repositories": [
        {
            "type": "path",
            "url": "../safi-*"
        },
        {
            "type": "path",
            "url": "../wajha-router"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}

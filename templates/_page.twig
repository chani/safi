<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}Safi Portal{% endblock %}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
    />
    <link rel="stylesheet" href="/assets/css/safi-dark.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  </head>
  <body>
    <div class="safi-app-container">
      {% if session.auth_user_id is not null %}
      <!-- Left Sidebar Navigation -->
      <aside class="safi-sidebar">
        <div class="safi-sidebar-brand">
          <i class="fa-solid fa-layer-group"></i> SAFI Admin
        </div>

        <nav class="safi-sidebar-nav">
          <div>
            <div class="safi-nav-section-title">Core Navigation</div>
            <ul>
              <li>
                <a href="/hello" class="active"
                  ><i class="fa-solid fa-chart-simple"></i> Dashboard</a
                >
              </li>
            </ul>
          </div>

          <div>
            <div class="safi-nav-section-title">Identity &amp; Access</div>
            <ul>
              <li>
                <a href="/admin/users"
                  ><i class="fa-solid fa-users"></i> User Directory</a
                >
              </li>
              <li>
                <a href="/admin/sessions"
                  ><i class="fa-solid fa-shield-halved"></i> Active Sessions</a
                >
              </li>
            </ul>
          </div>
        </nav>
      </aside>
      {% endif %}

      <!-- Main Wrapper -->
      <div class="safi-main-wrapper">
        <header class="safi-topbar">
          <div>
            <strong style="color: var(--safi-cyan)"
              ><i class="fa-solid fa-cube"></i> SAFI Portal</strong
            >
          </div>

          {% if session.auth_user_id is not null %}
          <div class="safi-topbar-search">
            <input
              type="search"
              id="global-search"
              placeholder="Global Search... (Press '/' to focus)"
            />
          </div>

          <div class="safi-topbar-user">
            <a
              href="/logout"
              class="outline contrast"
              role="button"
              style="padding: 0.2rem 0.6rem; font-size: 0.75rem"
            >
              <i class="fa-solid fa-right-to-bracket"></i> {{
              session.auth_username|default('admin') }}
            </a>
          </div>
          {% else %}
          <div>
            <a
              href="/login"
              class="contrast"
              role="button"
              style="padding: 0.25rem 0.75rem"
              ><i class="fa-solid fa-right-to-bracket"></i> Login</a
            >
          </div>
          {% endif %}
        </header>

        <main style="padding: 1.25rem; flex-grow: 1">
          {% block content %}{% endblock %}
        </main>
      </div>
    </div>

    <script>
      document.addEventListener("keydown", function (e) {
        if (e.key === "/" && document.activeElement.tagName !== "INPUT") {
          e.preventDefault();
          const search = document.getElementById("global-search");
          if (search) search.focus();
        }
      });
    </script>
  </body>
</html>

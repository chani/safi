{% extends "_page.twig" %} {% block title %}{{ title }}{% endblock %} {% block
content %}
<article>
  <header>
    <h3><i class="fa-solid fa-users"></i> User Directory</h3>
    <p><small>Manage system users and access roles</small></p>
  </header>

  <div class="grid">
    <div>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Email / Username</th>
            <th>Role</th>
            <th>Created</th>
            <th style="text-align: right">Action</th>
          </tr>
        </thead>
        <tbody>
          {% for u in users %}
          <tr>
            <td>{{ u.id }}</td>
            <td><strong>{{ u.email }}</strong></td>
            <td><mark>{{ u.role }}</mark></td>
            <td><small>{{ u.createdAt }}</small></td>
            <td style="text-align: right">
              {% if u.id != session.auth_user_id %}
              <form
                action="/admin/users/delete"
                method="post"
                style="margin: 0; display: inline"
                onsubmit="return confirm('Permanently delete user {{ u.email }}?');"
              >
                <input
                  type="hidden"
                  name="csrf_token"
                  value="{{ csrf_token }}"
                />
                <input type="hidden" name="id" value="{{ u.id }}" />
                <button
                  type="submit"
                  class="outline contrast"
                  style="
                    padding: 0.2rem 0.5rem;
                    font-size: 0.75rem;
                    color: var(--pico-del-color);
                  "
                >
                  <i class="fa-solid fa-trash"></i> Delete
                </button>
              </form>
              {% endif %}
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="5">No users registered in database.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div>
      <article>
        <header><strong>Create New User</strong></header>
        <form action="/admin/users/save" method="post">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
          <label>
            Email Address
            <input
              type="email"
              name="email"
              placeholder="user@domain.com"
              required
            />
          </label>
          <label>
            Password
            <input
              type="password"
              name="password"
              placeholder="••••••••"
              required
            />
          </label>
          <button type="submit" class="contrast w-100">Create User</button>
        </form>
      </article>
    </div>
  </div>
</article>
{% endblock %}
